# Version amont sur laquelle le patch « timeline-scope » est rebasé.
#
# La ligne `renovate:` ci-dessous est lue par le customManager déclaré dans
# renovate-config.js du dépôt immich-custom : quand immich-app/immich publie une
# release stable, Renovate ouvre une PR qui change UPSTREAM_TAG et l'automerge.
# Ce merge déclenche .github/workflows/timeline-scope-rebase.yml.
#
# renovate: datasource=github-releases depName=immich-app/immich
UPSTREAM_TAG=v3.1.0

# Révision du patch lui-même, à incrémenter À LA MAIN quand on modifie le patch sans
# que la version amont bouge. Le tag d'image publié vaut
# ${UPSTREAM_TAG}-timeline-scope.${PATCH_REVISION}, et il doit être strictement croissant
# au sens semver : sans cela Renovate ne verra pas la nouvelle image côté immich-custom.
PATCH_REVISION=1
